# Copy to .env at the repo root and fill in. Never commit .env.

# --- Supabase project (app) ---
# Project Settings -> API -> Project URL (https://<ref>.supabase.co)
SUPABASE_URL=
# Project Settings -> API Keys -> Publishable key. Safe for the browser.
SUPABASE_PUBLISHABLE_KEY=
# Project Settings -> API Keys -> Secret key. SERVER ONLY, bypasses RLS.
SUPABASE_SECRET_KEY=
# https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# --- Database (FastAPI connects directly) ---
# Project Settings -> Database -> Connection string -> Transaction pooler URI (port 6543)
DATABASE_URL=
POSTGRES_PASSWORD=

# --- Supabase MCP server (dev tooling only, not read by the app) ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
